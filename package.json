{
	"packageManager": "pnpm@10.17.1",
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3",
			"bufferutil",
			"core-js",
			"core-js-pure",
			"sharp"
		]
	},
	"scripts": {
		"start": "node main.js",
		"build": "pnpm --dir website run build",
		"dev": "concurrently \"pnpm --dir website start\" \"GGE_DEV=1 pnpm run start\""
	},
	"main": "main.js",
	"engines": {
		"node": "24.x"
	},
	"overrides": {
		"discord.js": {
			"undici": "6.24.1"
		}
	},
	"dependencies": {
		"better-sqlite3": "^12.8.0",
		"bufferutil": "^4.1.0",
		"concurrently": "^9.1.2",
		"dayjs": "^1.11.20",
		"discord.js": "^14.26.0",
		"emoji-dictionary": "^1.0.12",
		"express": "^5.2.1",
		"http-proxy-middleware": "^3.0.5",
		"i18n": "^0.15.3",
		"limiter": "^3.0.0",
		"node-cache": "^5.1.2",
		"pretty-time": "^1.1.0",
		"pureimage": "^0.4.18",
		"sharp": "^0.34.5",
		"turl": "^1.1.2",
		"undici": "^7.24.6",
		"ws": "^8.20.0",
		"xml2js": "^0.6.2"
	}
}
